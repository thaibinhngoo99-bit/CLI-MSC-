<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MSC</RootNamespace>
    <AssemblyName>MSC</AssemblyName>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MSC\Move.fs" />
    <Compile Include="MSC\Board.fs" />
    <Compile Include="MSC\Rules.fs" />
    <Compile Include="MSC\Game.fs" />
    <Compile Include="MSC\Program.fs" />
  </ItemGroup>

</Project>